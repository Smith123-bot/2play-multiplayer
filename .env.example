# ============================================================
# 2PLAY — ROOT ENVIRONMENT EXAMPLE
# Copy this file to `.env` (root) and/or to the workspace-level
# `.env` files (server/.env, client/.env) and fill in values.
# NEVER commit real secrets.
# ============================================================

# Server (server/.env)
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma separated list, or "*" for development. Restrict in production.
CORS_ORIGIN=http://localhost:5173

# Supabase (server-side ONLY — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct PostgreSQL connection string used to run SQL migrations.
# Supabase: Project Settings → Database → Connection string (URI, with SSL).
SUPABASE_DB_URL=

LOG_LEVEL=info

MAX_ROOMS=1000
MAX_PLAYERS_PER_ROOM=4
ROOM_TIMEOUT_MS=300000
ROOM_MAX_LIFETIME_MS=14400000
RECONNECT_GRACE_MS=120000
CHAT_RATE_LIMIT_PER_SEC=5
ACTION_RATE_LIMIT_PER_SEC=20
ROOM_CREATE_RATE_LIMIT_PER_MIN=20
ROOM_JOIN_RATE_LIMIT_PER_MIN=60
AUTH_RATE_LIMIT_PER_MIN=60
# Socket connections per client IP per minute. Raise this when players share a
# NAT/office network, and when TRUST_PROXY > 0 it is applied per real client.
SOCKET_CONNECT_RATE_LIMIT_PER_MIN=120

# ------------------------------------------------------------
# Search-engine submission & webmaster verification (optional)
# All of these stay EMPTY until you create the webmaster accounts.
# Never commit real values — they are deployment secrets/config.
# ------------------------------------------------------------
# IndexNow (Bing): 8–128 chars, A–Z a–z 0–9 and hyphen.
# When set, the server serves the ownership proof at /<INDEXNOW_KEY>.txt and
# `npm run seo:submit` pushes every public URL to IndexNow.
INDEXNOW_KEY=
# Google Search Console: value of the google-site-verification meta token.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: value of the msvalidate.01 meta token.
BING_SITE_VERIFICATION=

# Client (client/.env)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_NAME=2PLAY
VITE_APP_VERSION=2.1.0

# VITE_CONTACT_EMAIL — public contact email for /contact (build-time, public).
# EMPTY on purpose; set it in the deployment to publish a real mailbox.
VITE_CONTACT_EMAIL=
