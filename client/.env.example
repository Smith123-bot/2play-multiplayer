# Client environment (Vite). NEVER put secrets here — everything below is public.
# Leave VITE_API_URL / VITE_SOCKET_URL empty to use the same origin as the page
# (recommended for local dev: the Vite dev server proxies /api and /socket.io).
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_NAME=2PLAY
VITE_APP_VERSION=2.1.0

# Public contact email shown on /contact. EMPTY on purpose: no address is
# invented. Set it in the deployment to publish a real mailbox.
VITE_CONTACT_EMAIL=
